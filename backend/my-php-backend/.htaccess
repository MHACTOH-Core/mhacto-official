RewriteEngine On

# ── Let existing files through (uploads, vendor, etc.) ──
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# ── Let existing directories through ──
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── Route everything else to the central router ──
RewriteRule ^(.*)$ index.php [QSA,L]