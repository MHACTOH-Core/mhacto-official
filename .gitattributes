# Auto detect text files and ensure LF line endings in the repo.
# Windows users will get CRLF in their working directory automatically.
* text=auto eol=lf

# Force these to always be LF (scripts, configs)
*.sh    text eol=lf
*.sql   text eol=lf
*.php   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.xml   text eol=lf
*.svg   text eol=lf

# Denote binary files that should not be modified
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.mp4   binary
*.webm  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary

# Lock files — keep exact formatting
pnpm-lock.yaml  text eol=lf -diff
