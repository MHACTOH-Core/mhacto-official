# ── Frontend Environment Variables ────────────────────────────────
# Copy this file to .env.local and adjust values for your machine.
#
#   cp .env.example .env.local      (Linux / macOS)
#   copy .env.example .env.local    (Windows CMD)

# PHP backend URL (the address where `php -S` is running)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Base path for static export (GitHub Pages). Leave as-is for local dev.
NEXT_PUBLIC_BASE_PATH=/MHACTO-PROJECT
